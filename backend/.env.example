# MemoryOS hackathon demo
# Leave MONGO_URL empty to use the in-memory Mongo-compatible store.
MONGO_URL=
DB_NAME=memoryos
JWT_SECRET=replace-with-a-random-secret
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ADMIN_EMAIL=admin@memoryos.ai
ADMIN_PASSWORD=change-me
ADMIN_ORG_NAME=MemoryOS Demo

# Optional automation: paste an n8n Webhook URL.
N8N_WEBHOOK_URL=

# Optional monetization. Dodo checkout remains available when configured.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_GROWTH_MONTHLY_PRODUCT_ID=
DODO_GROWTH_ANNUAL_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=

# Optional semantic memory. Governance works without it.
BREETH_API_KEY=
BREETH_BASE_URL=https://api.thebreeth.com/v1
